---
// The YouTube trailer, behind a still: nothing from YouTube loads until it's played, and then from
// the no-cookie domain. Without a trailer id, the art shows on its own.
interface Props { youtubeId: string | null; still: string; title: string }
const { youtubeId, still, title } = Astro.props;
---

<div class="trailer">
  {
    youtubeId ? (
      <a href={`https://www.youtube.com/watch?v=${youtubeId}`} data-youtube={youtubeId} data-title={title}>
        <img src={still} alt="" width="920" height="430" />
        <span class="play">Play trailer</span>
      </a>
    ) : (
      <img src={still} alt={`${title} key art`} width="920" height="430" />
    )
  }
</div>

<style>
  .trailer {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 3px;
    background: var(--panel);
    border: 1px solid rgba(230, 223, 211, 0.08);
  }
  .trailer a { display: block; height: 100%; }
  .trailer img { width: 100%; height: 100%; object-fit: cover; }
  .trailer :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 12px 22px;
    background: rgba(14, 12, 13, 0.82);
    border: 1px solid var(--gold);
    color: var(--gold);
    font-family: var(--font-head);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .play::before {
    content: '';
    border-style: solid;
    border-width: 8px 0 8px 13px;
    border-color: transparent transparent transparent currentColor;
  }
  a:hover .play { color: var(--gold-hover); border-color: var(--gold-hover); }
</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>('a[data-youtube]').forEach((link) =>
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${link.dataset.youtube}?autoplay=1&rel=0`;
      frame.title = `${link.dataset.title ?? ''} trailer`;
      frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      frame.allowFullscreen = true;
      link.replaceWith(frame);
    }),
  );
</script>
