---
import type { Game } from '../lib/content';

interface Props { game: Game }
const { game } = Astro.props;
const tiers = Object.entries(game.requirements);
---

<div class="requirements">
  {tiers.map(([tier, rows]) => (
    <div class="panel">
      <h3>{tier.replace(/^./, (c) => c.toUpperCase())}</h3>
      <dl class="facts">
        {Object.entries(rows).map(([key, value]) => (
          <div>
            <dt>{key}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
    </div>
  ))}
</div>

<style>
  .requirements { display: grid; gap: 16px; }
  @media (min-width: 720px) {
    .requirements { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; }
  }
  .panel { padding: 24px; }
  h3 { color: var(--gold); font-size: 1rem; letter-spacing: 0.16em; text-transform: uppercase; }
  .requirements :global(.facts div) { grid-template-columns: 1fr; gap: 2px; }
</style>
