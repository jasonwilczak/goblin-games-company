---
// Screenshot thumbs. Each links to the full image; with JS, it opens in a viewer instead, with
// previous/next (buttons, arrow keys, or a swipe).
import { gameAsset, type Game } from '../lib/content';

interface Props { game: Game }
const { game } = Astro.props;
const shots = game.screenshots.map((s) => ({ ...s, fullUrl: gameAsset(game, s.full), thumbUrl: gameAsset(game, s.thumb) }));
---

<ul class="gallery" data-gallery>
  {
    shots.map((s, i) => (
      <li>
        <a href={s.fullUrl} data-index={i} data-alt={s.alt}>
          <img src={s.thumbUrl} alt={s.alt} width="640" height="360" loading="lazy" decoding="async" />
        </a>
      </li>
    ))
  }
</ul>

<dialog class="viewer" aria-label="Screenshot viewer">
  <figure>
    <img alt="" />
    <figcaption></figcaption>
  </figure>
  <button class="close" type="button" aria-label="Close">Close</button>
  <button class="prev" type="button" aria-label="Previous screenshot">‹</button>
  <button class="next" type="button" aria-label="Next screenshot">›</button>
</dialog>

<style>
  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }
  @media (min-width: 720px) {
    .gallery { grid-template-columns: repeat(3, 1fr); gap: 12px; }
  }
  .gallery a { display: block; border-radius: 2px; overflow: hidden; outline-offset: 2px; }
  .gallery img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--panel);
    transition: transform 0.25s, filter 0.25s;
    filter: brightness(0.92);
  }
  .gallery a:hover img { transform: scale(1.03); filter: brightness(1.05); }

  .viewer {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(8, 7, 8, 0.96);
    color: var(--text);
  }
  .viewer[open] { display: grid; place-items: center; }
  .viewer::backdrop { background: rgba(8, 7, 8, 0.9); }
  .viewer figure { margin: 0; padding: 56px var(--gutter); width: 100%; max-width: 1600px; }
  .viewer img { width: 100%; max-height: calc(100dvh - 160px); object-fit: contain; }
  .viewer figcaption { margin-top: 12px; text-align: center; color: var(--soft); }
  .viewer button {
    position: absolute;
    background: rgba(26, 25, 27, 0.8);
    border: 1px solid var(--line);
    color: var(--gold);
    font: inherit;
    cursor: pointer;
    min-width: 48px;
    min-height: 48px;
    border-radius: 2px;
  }
  .viewer button:hover { color: var(--gold-hover); border-color: var(--gold); }
  .viewer .close { top: 12px; right: 12px; padding: 0 16px; font-family: var(--font-head); letter-spacing: 0.08em; }
  .viewer .prev, .viewer .next { top: 50%; transform: translateY(-50%); font-size: 2rem; line-height: 1; }
  .viewer .prev { left: 8px; }
  .viewer .next { right: 8px; }
  @media (max-width: 719px) {
    .viewer .prev, .viewer .next { top: auto; bottom: 16px; transform: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((list) => {
    const viewer = list.nextElementSibling as HTMLDialogElement;
    if (!viewer?.showModal) return;
    const links = [...list.querySelectorAll<HTMLAnchorElement>('a')];
    const img = viewer.querySelector('img')!;
    const caption = viewer.querySelector('figcaption')!;
    let current = 0;

    const show = (i: number) => {
      current = (i + links.length) % links.length;
      const link = links[current];
      img.src = link.href;
      img.alt = link.dataset.alt ?? '';
      caption.textContent = `${link.dataset.alt ?? ''}  (${current + 1} of ${links.length})`;
    };

    links.forEach((link, i) =>
      link.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        viewer.showModal();
      }),
    );

    viewer.querySelector('.close')!.addEventListener('click', () => viewer.close());
    viewer.querySelector('.prev')!.addEventListener('click', () => show(current - 1));
    viewer.querySelector('.next')!.addEventListener('click', () => show(current + 1));
    viewer.addEventListener('click', (e) => {
      if (e.target === viewer || (e.target as HTMLElement).tagName === 'FIGURE') viewer.close();
    });
    viewer.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
    viewer.addEventListener('close', () => links[current].focus());

    let startX = 0;
    viewer.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    viewer.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
    });
  });
</script>
