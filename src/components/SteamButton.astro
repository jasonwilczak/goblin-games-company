---
// "Wishlist on Steam" once the store page exists; until then a disabled "Coming soon to Steam".
import type { Game } from '../lib/content';

interface Props { game: Game; class?: string }
const { game, class: extra = '' } = Astro.props;
const url = game.steam.url ?? (game.steam.appId ? `https://store.steampowered.com/app/${game.steam.appId}/` : null);
---

{
  url ? (
    <a class:list={['button', extra]} href={url} rel="noopener">
      Wishlist on Steam
    </a>
  ) : (
    <span class:list={['button', extra]} aria-disabled="true">
      Coming soon to Steam
    </span>
  )
}
