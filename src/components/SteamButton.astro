---
// "Wishlist on Steam" once steam.url is set (the store page is public); until then a disabled
// "Coming soon to Steam". The app ID alone doesn't switch it on: a hidden page redirects to Steam's home.
import type { Game } from '../lib/content';

interface Props { game: Game; class?: string }
const { game, class: extra = '' } = Astro.props;
const url = game.steam.url;
---

{
  url ? (
    <a class:list={['button', extra]} href={url} rel="noopener">
      Wishlist on Steam
    </a>
  ) : (
    <span class:list={['button', extra]} aria-disabled="true">
      Coming soon to Steam
    </span>
  )
}
